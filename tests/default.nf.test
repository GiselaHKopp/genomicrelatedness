nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    tag "test"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', '**/db/*_joint/**'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, relative: false, ignoreFile: 'tests/.nftignore')
            // BAM, CRAM and VCF files
            def bam_files = getAllFilesFromDir(params.outdir, include: ['**/*.bam'], ignore: ['**/variant_calling/**/*.bam'])
            def cram_files = getAllFilesFromDir(params.outdir, include: ['**/*.cram'])
            def vcf_files = getAllFilesFromDir(params.outdir, include: ['**/*.vcf{,.gz}'])
            // Reference fasta file for CRAM MD5 checks
            def fasta_base  = '/home/thomas/repositories/nf-core/test-datasets/data/'
            //def fasta_base  = 'https://raw.githubusercontent.com/nf-core/test-datasets/genomicrelatedness/'
            def fasta = fasta_base + 'reference_genome.fna.gz'

            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    removeFromYamlMap("${params.outdir}/pipeline_info/nf_core_genomicrelatedness_software_mqc_versions.yml", "Workflow", "Nextflow"),
                    // All files with stable contents
                    stable_content.isEmpty() ? 'No stable content' : stable_content,
                    // All stable path name, with a relative path
                    stable_name,
                    // BAM files
                    //bam_files.isEmpty() ? 'No BAM files' : bam_files.collect { file -> file.getName() + ":md5," + bam(file.toString()).readsMD5 },
                    // CRAM files
                    //cram_files.isEmpty() ? 'No CRAM files' : cram_files.collect { file -> file.getName() + ":md5," + cram(file.toString(), fasta).readsMD5 },
                    // VCF files
                    //vcf_files.isEmpty() ? 'No VCF files' : vcf_files.collect { file -> file.getName() + ":md5," + path(file.toString()).vcf.variantsMD5 }
                ).match() }
            )
        }
    }
}
