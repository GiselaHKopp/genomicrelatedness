nextflow_process {

    name "Test Process BCFTOOLS_CALL"
    script "../main.nf"
    process "BCFTOOLS_CALL"

    tag "modules"
    tag "modules_local"
    tag "bcftools"
    tag "bcftools/call"

    test("test-bcftools-call") {
        config './nextflow.config'

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'placeholder', checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
